{
  "name": "meitar-platform",
  "version": "0.1.0",
  "private": true,
  "description": "CRM and marketing platform for Meitar Real Estate & Investments",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "TZ=Asia/Jerusalem next dev",
    "build": "prisma generate && next build",
    "start": "TZ=Asia/Jerusalem node scripts/start.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "TZ=Asia/Jerusalem vitest run",
    "e2e": "TZ=Asia/Jerusalem node tests/e2e/run.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.18",
    "libphonenumber-js": "1.13.15",
    "next": "16.4.5",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
