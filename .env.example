# Copy to .env for local development. In Railway, set these under the web service's Variables.

# --- required ---
# Railway: add a PostgreSQL service, then set DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@localhost:5432/meitar"
# A long random secret for sign-in cookies (at least 32 characters). Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=""
# The site's public address, e.g. https://crm.meitargroup.co.il (Railway's RAILWAY_PUBLIC_DOMAIN is used if empty)
BETTER_AUTH_URL="http://localhost:3000"

# --- first administrator (only used while the database has no users) ---
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_PHONE=""
# optional: without it, a one-time link to set the password is written to the server log
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_EMAIL=""

# --- sign-in codes (SMS and/or WhatsApp) ---
# Until a provider is connected, codes can be written to the server log (Railway → Deployments → Logs):
ALLOW_CONSOLE_OTP="false"

# SMS through Twilio
SMS_PROVIDER=""                     # twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""                  # a Twilio number or an approved sender name, e.g. Meitar
TWILIO_MESSAGING_SERVICE_SID=""     # instead of TWILIO_SMS_FROM, if you use a Messaging Service

# WhatsApp through Meta's WhatsApp Cloud API (an approved "authentication" template)
WHATSAPP_PROVIDER=""                # meta | twilio
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_OTP_TEMPLATE=""            # template name, e.g. login_code
WHATSAPP_TEMPLATE_LANG="he"
WHATSAPP_OTP_BUTTON="true"          # false if the template has no "copy code" button
WHATSAPP_GRAPH_VERSION="v23.0"
# or WhatsApp through Twilio
TWILIO_WHATSAPP_FROM=""             # e.g. +14155238886
TWILIO_WHATSAPP_CONTENT_SID=""      # approved content template with {{1}} for the code
